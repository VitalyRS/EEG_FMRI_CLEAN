# European Data Format & BioSemi
*.edf
*.bdf
*.gdf

# NumPy arrays & scientific data dumps
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.dat
*.bin

# Neuroimaging (NIfTI, DICOM, etc.)
*.nii
*.nii.gz
*.dcm

# Databases (Optuna, SQLite)
*.db
*.sqlite
*.sqlite3

